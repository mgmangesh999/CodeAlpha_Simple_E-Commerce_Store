REACT_APP_GEMINI_API_KEY=your_gemini_api_key_here

REACT_APP_NAME=Atelier Store
REACT_APP_VERSION=1.0.0
REACT_APP_CURRENCY=USD
REACT_APP_FREE_SHIPPING_THRESHOLD=75
REACT_APP_SHIPPING_COST=8.99
